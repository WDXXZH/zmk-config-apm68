#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/led/led.h>
#include <dt-bindings/gpio/gpio.h>
#include "apm68-layouts.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &apm68_layout;
        zmk,underglow = &ws2812_0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";

        row-gpios
            = <&gpiob 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpioa  8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpioa  9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpioa 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpioa 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        col-gpios
            = <&gpiob  3 GPIO_ACTIVE_HIGH>
            , <&gpiob  4 GPIO_ACTIVE_HIGH>
            , <&gpiob  5 GPIO_ACTIVE_HIGH>
            , <&gpiob  6 GPIO_ACTIVE_HIGH>
            , <&gpiob  7 GPIO_ACTIVE_HIGH>
            , <&gpiob  8 GPIO_ACTIVE_HIGH>
            , <&gpiob  9 GPIO_ACTIVE_HIGH>
            , <&gpioa  3 GPIO_ACTIVE_HIGH>
            , <&gpioa  4 GPIO_ACTIVE_HIGH>
            , <&gpioa  5 GPIO_ACTIVE_HIGH>
            , <&gpioa  6 GPIO_ACTIVE_HIGH>
            , <&gpioa  7 GPIO_ACTIVE_HIGH>
            , <&gpiob  0 GPIO_ACTIVE_HIGH>
            , <&gpiob  1 GPIO_ACTIVE_HIGH>
            , <&gpiob 10 GPIO_ACTIVE_HIGH>
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <5>;
        columns = <15>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12)          RC(2,14)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)          RC(3,13) RC(3,14)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4)                            RC(4,7)          RC(4,9) RC(4,10)          RC(4,12) RC(4,13) RC(4,14)
        >;
    };

    encoder_0: encoder_0 {
        compatible = "alps,ec11";
        a-gpios = <&gpiob 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        b-gpios = <&gpiob 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        resolution = <4>;
        status = "okay";
    };

    ws2812_0: ws2812_0 {
        compatible = "worldsemi,ws2812-stm32";
        gpios = <&gpiob 14 GPIO_ACTIVE_HIGH>;
        chain-length = <68>;
        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
        reset-delay = <50>;
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder_0>;
        triggers-per-rotation = <20>;
    };
};
